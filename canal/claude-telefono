#!/bin/sh
# Abre Claude Code con el canal del teléfono. Solo esta sesión carga el canal: si estuviera en la
# configuración de usuario, cualquier `claude` lo arrancaría y se robaría los mensajes del teléfono
# sin registrarlos (ver docs/control-remoto-por-voz.md, paso D).
exec claude \
  --mcp-config "$HOME/.config/canal-papeleria/telefono.mcp.json" \
  --dangerously-load-development-channels server:telefono \
  "$@"
