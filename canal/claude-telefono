#!/bin/sh
# Abre Claude Code con el canal del teléfono. El canal está en la configuración de usuario, así que
# cualquier `claude` lo arranca; solo pregunta al relevo con CANAL_TELEFONO=1, y solo esta sesión
# lo registra como canal (ver docs/control-remoto-por-voz.md, paso D).
CANAL_TELEFONO=1 exec claude --dangerously-load-development-channels server:telefono "$@"
